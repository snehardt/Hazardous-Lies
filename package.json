{
  "name": "hazardous-lies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "relay:dev": "wrangler dev --config relay/wrangler.toml --port 8787",
    "relay:login": "wrangler login",
    "relay:deploy": "pnpm build:site && wrangler deploy --config relay/wrangler.toml",
    "build:site": "pnpm build && node scripts/prepare-site.mjs",
    "build": "tsc && esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/main.js",
    "check": "tsc --noEmit",
    "test": "node tests/smoke.mjs",
    "test:rooms": "node tests/rooms.mjs",
    "test:network": "node tests/network.mjs",
    "test:online": "node tests/online.mjs",
    "test:snapshots": "node tests/snapshots.mjs",
    "test:prediction": "node tests/prediction.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.150.0"
  }
}
