{
  "name": "hazardous-lies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc && esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/main.js",
    "check": "tsc --noEmit",
    "test": "node tests/smoke.mjs",
    "test:rooms": "node tests/rooms.mjs",
    "test:network": "node tests/network.mjs",
    "test:online": "node tests/online.mjs",
    "test:snapshots": "node tests/snapshots.mjs",
    "test:prediction": "node tests/prediction.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "peer": "^1.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
